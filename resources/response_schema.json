{
  "title": "TaskResponse",
  "type": "object",
  "properties": {
    "summary": {
      "type": "string",
      "description": "Short summary of what was completed"
    },
    "status": {
      "type": "string",
      "enum": ["completed", "blocked", "needs_input"],
      "description": "Overall status of the task"
    },
    "follow_up_tasks": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Next steps, if any"
    }
  },
  "required": ["summary", "status"],
  "additionalProperties": false
}
